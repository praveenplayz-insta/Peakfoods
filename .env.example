# Copy to .env and fill in. Never commit .env to GitHub.
PORT=3000
APP_URL=http://localhost:3000
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=*

# First admin account (created on first start)
ADMIN_EMAIL=admin@peakfoods.com
ADMIN_PASSWORD=ChangeThisNow123

DELIVERY_FEE=30
DB_PATH=./data.db

# Email (SMTP). Leave SMTP_HOST empty in development: emails are printed in the console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your-gmail-app-password
MAIL_FROM=PeakFoods <youraddress@gmail.com>

# Razorpay (Dashboard > Account & Settings > API Keys). Use rzp_test_ keys first.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=choose-a-webhook-secret
